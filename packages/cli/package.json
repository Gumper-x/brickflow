{
  "name": "@brickflow/cli",
  "version": "0.0.59",
  "description": "",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./icon": {
      "types": "./src/icon/generate.d.ts",
      "import": "./src/icon/generate.js"
    }
  },
  "bin": {
    "brick": "./index.mjs"
  },
  "scripts": {
    "latest": "node ./index.mjs latest",
    "lint": "pnpm run --if-present typecheck && eslint -v && NODE_ENV=deploy eslint --cache .",
    "lint:fix": "pnpm exec eslint . --fix",
    "format": "pnpm exec prettier . --ignore-path ../../.prettierignore --write",
    "format:check": "pnpm exec prettier . --ignore-path ../../.prettierignore --check"
  },
  "dependencies": {
    "@babel/parser": "8.0.10",
    "@babel/traverse": "8.0.10",
    "@babel/types": "8.0.10",
    "@google/genai": "2.32.0",
    "@napi-rs/canvas": "1.1.0",
    "@vue/compiler-sfc": "3.5.44",
    "fantasticon": "4.1.0",
    "glob": "14.0.3",
    "looks-same": "10.0.1",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "svgpath": "2.6.0",
    "transformation-matrix": "3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@brickflow/lint": "workspace:*",
    "@brickflow/prettier": "workspace:*"
  },
  "author": "",
  "license": "ISC"
}
