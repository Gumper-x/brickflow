{
  "compilerOptions": {
    "types": ["vue"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["development"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "fallthroughAttributes": true,
    "checkRequiredFallthroughAttributes": true,
    "checkUnknownEvents": false,
    "dataAttributes": ["data-*", "draggable", "onClick"]
  },
  "exclude": ["**/node_modules", "**/.nuxt", "**/.output", "**/dist"],
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "../../apps/playground/.nuxt/types/brickflow-ui-config-literals.d.ts"
  ]
}
