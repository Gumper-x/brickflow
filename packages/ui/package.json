{
  "name": "@brickflow/ui",
  "version": "0.0.38",
  "type": "module",
  "description": "brickflow UI Nuxt module.",
  "files": [
    "dist"
  ],
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./tailwind": {
      "types": "./dist/runtime/tailwind.d.ts",
      "import": "./dist/runtime/tailwind.js"
    },
    "./ui.css": {
      "development": "./src/runtime/ui.css",
      "default": "./dist/runtime/ui.css"
    }
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "vue-tsc --project tsconfig.json --noEmit",
    "lint": "pnpm typecheck && eslint -v && NODE_ENV=deploy eslint --cache .",
    "lint:fix": "pnpm exec eslint . --fix",
    "format": "pnpm exec prettier . --ignore-path ../../.prettierignore --write",
    "format:check": "pnpm exec prettier . --ignore-path ../../.prettierignore --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "fantasticon": "4.1.0",
    "jiti": "2.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@brickflow/lint": "workspace:*",
    "@brickflow/prettier": "workspace:*",
    "@nuxt/kit": "4.5.1",
    "@nuxt/module-builder": "1.0.3",
    "nuxt": "4.5.1",
    "vue": "3.5.40",
    "vue-tsc": "3.3.9"
  },
  "author": "",
  "license": "ISC"
}
