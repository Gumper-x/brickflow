{
  "name": "@brickflow/http",
  "version": "0.0.15",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./nuxt": {
      "types": "./src/nuxt.ts",
      "import": "./src/nuxt.ts",
      "default": "./src/nuxt.ts"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS='--conditions=development' nuxt-module-build build",
    "typecheck": "NODE_OPTIONS='--conditions=development' node ../brick/node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
    "lint": "pnpm run --if-present typecheck",
    "lint:fix": "pnpm exec eslint . --fix",
    "format": "pnpm exec prettier . --ignore-path ../../.prettierignore --write",
    "format:check": "pnpm exec prettier . --ignore-path ../../.prettierignore --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nuxt/kit": "3.21.7"
  },
  "devDependencies": {
    "@brickflow/lint": "workspace:*",
    "@brickflow/prettier": "workspace:*",
    "vue-tsc": "3.3.2"
  },
  "peerDependencies": {
    "nuxt": ">=3",
    "vue": ">=3"
  }
}
