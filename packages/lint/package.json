{
  "name": "@brickflow/lint",
  "version": "0.0.37",
  "type": "module",
  "description": "Shared ESLint configs for brickflow workspaces.",
  "files": [
    "index.cjs",
    "index.js",
    "shared.js",
    "brick.js",
    "rules"
  ],
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    }
  },
  "scripts": {
    "lint": "pnpm run --if-present typecheck && eslint -v && NODE_ENV=deploy eslint --cache .",
    "lint:fix": "pnpm exec eslint . --fix",
    "format": "pnpm exec prettier . --ignore-path ../../.prettierignore --write",
    "format:check": "pnpm exec prettier . --ignore-path ../../.prettierignore --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.1.1",
    "eslint-plugin-tailwindcss": "4.2.0",
    "eslint-plugin-unicorn": "72.0.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "typescript-eslint": "8.65.0",
    "vue-eslint-parser": "10.4.1"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3"
  },
  "author": "",
  "license": "ISC"
}
